+# Metadata for a block from a run before blocks.jsonl existed: its decisions were logged, its load was not.
+LEGACY_META = {"load_state": {"mode": "not recorded (block from a run before the runner saved block metadata)"},
+               "thermal": None, "phases": None, "file_bytes": None, "spawn_to_ready_ms": None,
+               "timing_note": "not recorded", "token_def": "not recorded", "torch_threads": None, "rss_mib": None,
+               "peak_mib": None, "wait4_maxrss_mib": None, "legacy": True}
+
+
+def block_plan(models, threads, main_only):
+    """name -> [(block, threads, orders, cold)]: a cold main block at the highest thread count, then cached t<N>."""
+    return {name: [("main", threads[-1], ("written", "reversed"), True)] +
+                  ([] if name in main_only else [(f"t{t}", t, ("written",), False) for t in threads])
+            for name in models}
+
+
+def load_done(out, plan, cases):
+    """{(model, block): block with rows} for the planned blocks an earlier run in OUT completed with valid data.
+    A block is listed in blocks.jsonl only after it finished with cores 4-7 held throughout. OUT from before
+    blocks.jsonl existed: a block counts if all its rows are present and a later block started, because the
+    runner started the next block only after the previous one passed its post-block core check."""
+    rows, seen = {}, []
+    path = out / "decisions.jsonl"
+    for line in path.read_text().splitlines() if path.exists() else []:
+        r = json.loads(line)
+        key = (r["model"], r["block"])
+        if key not in rows:
+            rows[key] = []
+            seen.append(key)
+        rows[key].append(r)
+    if (out / "blocks.jsonl").exists():
+        metas = {(m["model"], m["block"]): m for m in map(json.loads, (out / "blocks.jsonl").read_text().splitlines())}
+    else:
+        metas = {k: {**LEGACY_META, "model": k[0], "block": k[1], "threads": rows[k][0]["threads"]} for k in seen[:-1]}
+    done = {}
+    for name, blocks in plan.items():
+        for block, threads, orders, _ in blocks:
+            k, want = (name, block), {(c["id"], o) for c in cases for o in orders}
+            got = [(r["case_id"], r["order"]) for r in rows.get(k, [])]
+            if k in metas and metas[k]["threads"] == threads and len(got) == len(want) and set(got) == want:
+                done[k] = {**metas[k], "rows": rows[k]}
+    return done
+
+
