+SHA256 = {MODEL: repro.SHA256[MODEL], DRAFT: repro.SHA256[DRAFT],
+          MMPROJ: '9406f99c16d68cda4f1f0552192dcc99021ea1fc6d2fd50b1dc3ccf30d04b292'}  # hashed on the phone 2026-10-23
