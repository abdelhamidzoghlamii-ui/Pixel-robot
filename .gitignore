# Models — exceed GitHub's 100MB limit, not needed to read the code
*.onnx
*.gguf
*.bin

# Benchmark captures — stay on the phone
bench_photos/
benchmark/*
!benchmark/strategic_selector/

# Run artifacts
*.csv
*.log
*.bak
__pycache__/
*.pyc
!benchmark/llm_objective_setting/
benchmark/llm_objective_setting/combined_*.tsv
benchmark/llm_objective_setting/blind_ab.txt
benchmark/llm_objective_setting/blind_key.tsv

# Strategic-selector v3: case generator, sealed held-out split, and the review request that inlines the generator
benchmark/strategic_selector/v3/cases.py
benchmark/strategic_selector/v3/heldout.jsonl
review_v3_request.txt

# RelateAnything: own benchmark code/evidence only; external model assets excluded
!benchmark/relate_anything/
benchmark/relate_anything/**/.speed.lock
benchmark/relate_anything/**/__pycache__/
benchmark/relate_anything/**/*.pth
benchmark/relate_anything/**/*_feed.npz
benchmark/relate_anything/**/*vocab*.npz
benchmark/relate_anything/**/*bank*.npz

# CAMPAIGN_P1 runner and mock verification evidence
!benchmark/campaign/

# HEAT-A heat-control evidence
!benchmark/heat_control/

# VIS-3C / VIS-3D archives: under gemma_vision only vis3d is unignored; run logs in both archives are evidence
!benchmark/gemma_vision/
benchmark/gemma_vision/*
!benchmark/gemma_vision/vis3d/
!benchmark/gemma_vision/vis3d/runs/**/*.log
!benchmark/llm_objective_setting/conversation/chat_mtp_repro/runs/**/*.log

# VIS-0 archive (tracked since 685a44b): unignore so its catalogs and review transcripts are visible
!benchmark/gemma_vision/vis0/

# MEM-1 memory-context benchmark: only its source, frozen set, tests and docs are trackable; runs are written to
# ~/robot_runs/mem1/ outside the repository, and anything else created here stays ignored
!benchmark/memory_context/
benchmark/memory_context/*
!benchmark/memory_context/mem1.py
!benchmark/memory_context/oneshot.sh
!benchmark/memory_context/build_set.py
!benchmark/memory_context/memory_set.json
!benchmark/memory_context/test_mem1.py
!benchmark/memory_context/README.md
!benchmark/memory_context/RUN_INDEX.md
!benchmark/memory_context/ARTIFACTS.md
# MEM-1 archive (2026-10-30): byte-for-byte copies of ~/robot_runs/mem1/; run logs are evidence
!benchmark/memory_context/runs/
!benchmark/memory_context/runs/**/*.log
