+          'Mention only what you can see.')  # VIS-0 photo-only prompt (no YOLO list: VIS-0 saw it copy YOLO errors)
+ENV_REFUSED = ('LLAMA_', 'GGML_', 'OMP_', 'KMP_', 'LD_LIBRARY_PATH')  # would change the server (LLAMA_ARG_* = flags)
