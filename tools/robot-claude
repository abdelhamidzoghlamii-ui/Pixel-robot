#!/data/data/com.termux/files/usr/bin/bash
# Start claude in the existing Debian environment from native Termux.
if [[ ! -x /data/data/com.termux/files/usr/bin/proot-distro ]]; then
    printf '%s\n' 'robot-claude: proot-distro is unavailable.' >&2
    exit 127
fi
exec /data/data/com.termux/files/usr/bin/proot-distro login debian --bind /data/data/com.termux/files/home:/termux-home -- /bin/bash -lc '
    cd /termux-home/robot || exit 1
    if [[ ! -f "$1" || ! -x "$1" ]]; then
        printf "Executable unavailable in Debian: %s\n" "$1" >&2
        exit 127
    fi
    exec "$@"
' robot-claude /root/.local/bin/claude "$@"
